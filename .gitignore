node_modules/
dist/
out/

# The built installer is copied to the repo root for convenience. It is ~190MB,
# which is both over GitHub's file limit and permanent once it lands in history.
# Releases carry the binary; the repo carries the source that builds it.
/*.exe
/*.exe.blockmap
native/systemaudio
*.log
.DS_Store
cue-data.json

# Speaker model (28MB, fetched separately) and scratch test audio
models/*.onnx
spk_test/*.wav
src/fonts/*.zip
probe.js
build.log

# Local tool state. .claude/ in particular can accumulate shell commands that
# were run against this repo, which is exactly where a pasted API key ends up.
.claude/
.tokensave/
nimbus-data.json
